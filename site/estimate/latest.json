      "formula": "energy = (omie + adjustment_services + capacity_payment) / 1000 × (1 + loss_factor) + retailer_margin / 1000; pre_tax = energy + peaje + cargo; iee = pre_tax × IEE; estimate = (pre_tax + iee) × (1 + IVA)",
      "assumptions": {
        "loss_factor": {
          "value": 0.16,
          "note": "ASSUMPTION. Busbar energy is grossed up for network losses. Default from the median ratio PVPC PMH / OMIE hourly mean = 1.161 over the 36 hours with OMIE > 5 €/MWh on 9–10 Oct 2026 (the ratio includes losses and small market adjustments; official hourly loss coefficients are on ESIOS and need a token)."
        },
        "adjustment_services_eur_mwh": {
          "value": 28.0,
          "note": "ASSUMPTION. Ancillary/adjustment services plus OMIE/REE fees. Default from the median of PVPC SAH+FOM+FOS+INT over the 48 hours of 9–10 Oct 2026 (≈28; range 18.4–58.3 €/MWh)."
        },
        "retailer_margin_eur_mwh": {
